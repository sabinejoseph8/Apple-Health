{
  "name": "clarivi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/check-build-secrets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:functions": "deno test --no-lock supabase/functions",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:test": "supabase test db",
    "check:local": "node scripts/local-1a-check.mjs",
    "check:local:sync": "node scripts/local-1b-check.mjs",
    "check:local:import": "node scripts/local-import-load.mjs",
    "check:local:notify": "node scripts/local-4-check.mjs",
    "check:local:account": "node scripts/local-5-check.mjs",
    "test:e2e": "playwright test",
    "wording:sheet": "node scripts/wording-sheet.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "deno": "^2.9.6",
    "supabase": "^2.119.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
