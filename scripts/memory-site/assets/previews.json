{
 "comp-app-header": "<div class=\"well \"><div class=\"ap-header\"><div><div class=\"ap-eyebrow\">Tuesday 29 September</div><div class=\"ap-large\">Good morning</div></div><span class=\"ap-gear\" aria-label=\"Settings\"><svg class=\"ic\" viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"3.3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M12 2.8v2.6M12 18.6v2.6M2.8 12h2.6M18.6 12h2.6M5.5 5.5l1.9 1.9M16.6 16.6l1.9 1.9M5.5 18.5l1.9-1.9M16.6 7.4l1.9-1.9\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg></span></div></div>",
 "comp-nav-bar": "<div class=\"well \"><div class=\"ap-nav\"><span class=\"ap-back\"><svg class=\"ic\" viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" aria-hidden=\"true\"><path d=\"M9 5l7 7-7 7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Today</span><span class=\"ap-nav-t\">Why ease off today</span><span></span></div></div>",
 "comp-status-pill": "<div class=\"well wrap\"><span class=\"ap-pill\" style=\"color:var(--app-good);background:var(--app-good-pill)\">Ready</span><span class=\"ap-pill\" style=\"color:var(--app-ease);background:var(--app-ease-pill)\">Ease off</span><span class=\"ap-pill\" style=\"color:var(--app-rest);background:var(--app-rest-pill)\">Rest</span><span class=\"ap-pill\" style=\"color:var(--app-text2);background:var(--app-neutral-pill)\">Learning your usual levels</span><span class=\"ap-sync\">Updated from your Watch at 6:42am</span></div>",
 "comp-briefing-card": "<div class=\"well \"><div class=\"ap-card\"><span class=\"ap-pill\" style=\"color:var(--app-ease);background:var(--app-ease-pill)\">Ease off</span><span class=\"ap-sync\"> 6:42am</span><div class=\"ap-headline\">Your body is still catching up</div><p class=\"ap-body\">Your sleep was short and your heart rate variability was low.</p><div class=\"ap-nudge\"><span class=\"ap-eyebrow ease\">Today's nudge</span><span class=\"ap-nudge-t\">Train easy today</span><span class=\"ap-nudge-s\">Keep today's session short and light.</span></div><div class=\"ap-linkrow\"><span>Why ease off today</span><svg class=\"ic\" viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" aria-hidden=\"true\"><path d=\"M9 5l7 7-7 7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></div></div></div>",
 "comp-nudge-block": "<div class=\"well \"><div class=\"ap-card flat\"><div class=\"ap-nudge\"><span class=\"ap-eyebrow ease\">Today's nudge</span><span class=\"ap-nudge-t\">Train easy today</span><span class=\"ap-nudge-s\">Keep today's session short and light.</span></div></div></div>",
 "comp-follow-through-card": "<div class=\"well \"><div class=\"ap-card ring-blue\"><span class=\"ap-eyebrow blue\"><svg class=\"ic\" viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" aria-hidden=\"true\"><path d=\"M6.5 16.5V11a5.5 5.5 0 0 1 11 0v5.5l1.6 1.8H4.9z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linejoin=\"round\"/><path d=\"M10 20.5a2.2 2.2 0 0 0 4 0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\"/></svg> Today's nudge</span><div class=\"ap-headline sm\">Train easy today</div><p class=\"ap-q\">Did you follow it?</p><div class=\"ap-yn\"><span class=\"ap-btn\">Yes</span><span class=\"ap-btn\">No</span></div><p class=\"ap-hint\">You can change your answer until tomorrow morning</p></div></div>",
 "comp-check-in-row": "<div class=\"well \"><div class=\"ap-card row\"><span class=\"ap-ic\"><svg class=\"ic\" viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\"/><circle cx=\"9\" cy=\"10\" r=\"1.2\" fill=\"currentColor\"/><circle cx=\"15\" cy=\"10\" r=\"1.2\" fill=\"currentColor\"/><path d=\"M8.5 15h7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\"/></svg></span><span class=\"ap-row-t\">You said you feel okay today</span><span class=\"ap-link\">Change</span></div></div>",
 "comp-daily-check-in-screen": "<div class=\"well \"><div class=\"ap-card center\"><div class=\"ap-headline sm\">How do you feel today?</div><div class=\"ap-3\"><span class=\"ap-btn\">Good</span><span class=\"ap-btn\">Okay</span><span class=\"ap-btn\">Off</span></div><span class=\"ap-link\">Skip</span></div></div>",
 "comp-list-row": "<div class=\"well \"><div class=\"ap-card row\"><span class=\"ap-ic blue\"><svg class=\"ic\" viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" aria-hidden=\"true\"><rect x=\"4\" y=\"5.5\" width=\"16\" height=\"14.5\" rx=\"2.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"/><path d=\"M4 10h16M8.5 3.5v4M15.5 3.5v4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg></span><span class=\"ap-row-t\">Weekly digest</span><span class=\"ap-muted\">21 to 27 Sep</span><span class=\"ap-chev\"><svg class=\"ic\" viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" aria-hidden=\"true\"><path d=\"M9 5l7 7-7 7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></div></div>",
 "comp-summary-card": "<div class=\"well \"><div class=\"ap-card\"><span class=\"ap-pill\" style=\"color:var(--app-ease);background:var(--app-ease-pill)\">Ease off</span><div class=\"ap-headline sm\">Train easy today</div><p class=\"ap-body\">Two of your three recovery readings were low last night.</p></div></div>",
 "comp-reading-card": "<div class=\"well \"><div class=\"ap-card\"><div class=\"ap-rd-head\"><span style=\"color:var(--app-hrv)\"><svg class=\"ic\" viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" aria-hidden=\"true\"><path d=\"M2.5 12h4l2-5 3.5 10 2.5-7 1.5 2h5.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg> Heart rate variability</span><span class=\"ap-muted\">Last night</span></div><p class=\"ap-cap\">Measured in milliseconds. Higher is usually better.</p><div class=\"ap-rd-vals\"><span class=\"ap-big\">38<small> ms</small></span><span class=\"ap-normal\"><small>Usual for you</small>52 ms</span></div><div class=\"ap-verdict ease\"><svg class=\"ic\" viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" aria-hidden=\"true\"><path d=\"M12 5v13M6.5 12.5 12 18l5.5-5.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg> Below your usual range</div><svg class=\"mini\" viewBox=\"0 0 300 72\" role=\"img\" aria-label=\"Four weeks of nights with the usual range shaded\"><rect x=\"0\" y=\"21.4\" width=\"300\" height=\"29.1\" rx=\"3\" fill=\"var(--app-hrv-band)\"/><line x1=\"0\" x2=\"300\" y1=\"36.0\" y2=\"36.0\" stroke=\"var(--app-hrv-med)\" stroke-width=\"1.4\" stroke-dasharray=\"4 4\"/><polyline points=\"4.0,31.8 14.7,33.8 25.3,28.1 36.0,23.0 46.7,35.2 57.3,44.1 68.0,40.5 78.7,43.8 89.3,45.8 100.0,32.1 110.7,24.8 121.3,30.9 132.0,30.1 142.7,30.4 153.3,44.2 164.0,48.8 174.7,39.6 185.3,38.6 196.0,37.2 206.7,24.7 217.3,23.7 228.0,35.5 238.7,37.3 249.3,38.4 260.0,48.6 270.7,46.0 281.3,32.4 292.0,57.3\" fill=\"none\" stroke=\"var(--app-hrv)\" stroke-width=\"1.8\" stroke-linejoin=\"round\" stroke-linecap=\"round\" vector-effect=\"non-scaling-stroke\"/><circle cx=\"292.0\" cy=\"57.3\" r=\"4.2\" fill=\"var(--app-attn)\" stroke=\"#FFFFFF\" stroke-width=\"1.6\"/></svg><span class=\"ap-link\">Show the numbers</span></div></div>",
 "comp-mini-chart": "<div class=\"well \"><div class=\"ap-card flat\"><svg class=\"mini\" viewBox=\"0 0 300 72\" role=\"img\" aria-label=\"Four weeks of nights with the usual range shaded\"><rect x=\"0\" y=\"21.4\" width=\"300\" height=\"29.1\" rx=\"3\" fill=\"var(--app-hrv-band)\"/><line x1=\"0\" x2=\"300\" y1=\"36.0\" y2=\"36.0\" stroke=\"var(--app-hrv-med)\" stroke-width=\"1.4\" stroke-dasharray=\"4 4\"/><polyline points=\"4.0,31.8 14.7,33.8 25.3,28.1 36.0,23.0 46.7,35.2 57.3,44.1 68.0,40.5 78.7,43.8 89.3,45.8 100.0,32.1 110.7,24.8 121.3,30.9 132.0,30.1 142.7,30.4 153.3,44.2 164.0,48.8 174.7,39.6 185.3,38.6 196.0,37.2 206.7,24.7 217.3,23.7 228.0,35.5 238.7,37.3 249.3,38.4 260.0,48.6 270.7,46.0 281.3,32.4 292.0,57.3\" fill=\"none\" stroke=\"var(--app-hrv)\" stroke-width=\"1.8\" stroke-linejoin=\"round\" stroke-linecap=\"round\" vector-effect=\"non-scaling-stroke\"/><circle cx=\"292.0\" cy=\"57.3\" r=\"4.2\" fill=\"var(--app-attn)\" stroke=\"#FFFFFF\" stroke-width=\"1.6\"/></svg><div class=\"mini-labels\"><span>4 weeks ago</span><span>Shaded: your usual range</span><span>Last night</span></div></div></div>",
 "comp-also-checked-card": "<div class=\"well \"><div class=\"ap-card\"><div class=\"ap-sec-t\">Also checked</div><p class=\"ap-body\">Breathing rate and yesterday's resting heart rate were in your normal range. No early sign of illness or heavy strain.</p></div></div>",
 "comp-status-decision-section": "<div class=\"well \"><div class=\"ap-card flat\"><div class=\"ap-zones\"><div class=\"ap-zone\"><span class=\"ap-zone-t\">Ready</span><span class=\"ap-zone-v\">under 1.2</span></div><div class=\"ap-zone today ring-orange\"><span class=\"ap-zone-tag\">Today</span><span class=\"ap-zone-t\">Ease off</span><span class=\"ap-zone-v\">1.2 to 2.4</span></div><div class=\"ap-zone\"><span class=\"ap-zone-t\">Rest</span><span class=\"ap-zone-v\">2.4 or more</span></div></div></div></div>",
 "comp-primary-button": "<div class=\"well \"><span class=\"ap-primary\">See your trends</span></div>",
 "comp-text-button-and-link-row": "<div class=\"well \"><div class=\"ap-card flat\"><span class=\"ap-link\">Show the numbers</span><div class=\"ap-linkrow\"><span>Why ease off today</span><svg class=\"ic\" viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" aria-hidden=\"true\"><path d=\"M9 5l7 7-7 7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></div></div></div>",
