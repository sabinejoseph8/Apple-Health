 "comp-forms": "<div class=\"well \"><div class=\"ap-card\"><label class=\"ap-label\">Email</label><span class=\"ap-input\">sabine@example.com</span><label class=\"ap-label\">Password</label><span class=\"ap-input\">••••••••••••</span><span class=\"ap-primary sm\">Sign in</span><p class=\"ap-hint\">Forgot your password? Contact Sabine.</p></div></div>",
 "comp-settings-list": "<div class=\"well \"><div class=\"ap-card list\"><div class=\"ap-set\">Notifications<svg class=\"ic\" viewBox=\"0 0 24 24\" width=\"13\" height=\"13\" aria-hidden=\"true\"><path d=\"M9 5l7 7-7 7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></div><div class=\"ap-set\">Upload token<svg class=\"ic\" viewBox=\"0 0 24 24\" width=\"13\" height=\"13\" aria-hidden=\"true\"><path d=\"M9 5l7 7-7 7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></div><div class=\"ap-set\">Change password<svg class=\"ic\" viewBox=\"0 0 24 24\" width=\"13\" height=\"13\" aria-hidden=\"true\"><path d=\"M9 5l7 7-7 7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></div><div class=\"ap-set red\">Delete my data</div></div></div>",
 "comp-notification-text": "<div class=\"well \"><div class=\"ap-notif\"><span class=\"ap-notif-ic\"><svg class=\"ic\" viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" aria-hidden=\"true\"><path d=\"M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.4 4.3 4.3 0 0 1 19.5 10C19.5 15.4 12 20 12 20z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linejoin=\"round\"/></svg></span><div><div class=\"ap-notif-t\">Clarivi <span>now</span></div><div class=\"ap-notif-b\">Ease off today: HRV well below your usual, sleep short</div></div></div></div>",
